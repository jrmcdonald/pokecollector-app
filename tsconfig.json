{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // TypeScript 6 no longer picks up every @types package by default.
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // The simulator tests' and release scripts' Node code has its own configs
  // (e2e/ and scripts/tsconfig.json): Node's types would otherwise leak into
  // the app's.
  "exclude": ["node_modules", "ios", "android", "e2e", "scripts"]
}
