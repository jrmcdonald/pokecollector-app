{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // TypeScript 6 no longer picks up every @types package by default.
    "types": ["jest"],
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // The simulator tests' Node code has its own config (e2e/tsconfig.json):
  // Node's types would otherwise leak into the app's.
  "exclude": ["node_modules", "ios", "android", "e2e"]
}
